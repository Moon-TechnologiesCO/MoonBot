<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoonBot.App.App"
             RequestedThemeVariant="Dark">

    <!-- Paleta "noche lunar" de Moon Technologies. Un solo lugar para los colores. -->
    <Application.Resources>
        <Color x:Key="SystemAccentColor">#8FB3FF</Color>
        <Color x:Key="SystemAccentColorDark1">#7A9EEA</Color>
        <Color x:Key="SystemAccentColorDark2">#6488D4</Color>
        <Color x:Key="SystemAccentColorDark3">#4E72BE</Color>
        <Color x:Key="SystemAccentColorLight1">#A6C3FF</Color>
        <Color x:Key="SystemAccentColorLight2">#BDD3FF</Color>
        <Color x:Key="SystemAccentColorLight3">#D4E2FF</Color>

        <SolidColorBrush x:Key="NightBrush" Color="#0B1026" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#10173A" />
        <SolidColorBrush x:Key="CardBrush" Color="#161E46" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#252E62" />
        <SolidColorBrush x:Key="TextBrush" Color="#ECE8DA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA3C7" />
        <SolidColorBrush x:Key="MoonlightBrush" Color="#F2D98D" />
        <SolidColorBrush x:Key="MoonlightHoverBrush" Color="#F7E5AE" />
        <SolidColorBrush x:Key="InkBrush" Color="#1B2140" />
        <SolidColorBrush x:Key="NavSelectedBrush" Color="#222B5C" />
        <SolidColorBrush x:Key="NavHoverBrush" Color="#1A2250" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,18" />
        </Style>

        <Style Selector="TextBox, ComboBox, AutoCompleteBox, NumericUpDown">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- Botón principal: luz de luna -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource MoonlightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,9" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource MoonlightHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E3C772" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- Botón discreto -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <!-- Navegación lateral -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource NavHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
        </Style>

        <!-- Sugerencias en el chat vacío -->
        <Style Selector="Button.suggestion">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.suggestion:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource NavSelectedBrush}" />
            <Setter Property="BorderBrush" Value="#3A4588" />
        </Style>

        <!-- Caja de texto sin marco (dentro del compositor del chat) -->
        <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Styles>
</Application>
