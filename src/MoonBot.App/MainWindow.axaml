<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:MoonBot.App"
        mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="340"
        x:Class="MoonBot.App.MainWindow"
        Width="260" Height="340" CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Title="MoonBot">
    <!-- Ventana flotante: sin bordes, transparente, siempre encima,
         fuera de la barra de tareas y sin robar el foco al aparecer. -->
    <Grid RowDefinitions="Auto,*">
        <Border x:Name="BubbleBorder" Grid.Row="0" IsVisible="False"
                Margin="12,12,12,0" Padding="14,10" MinHeight="40"
                CornerRadius="14" Background="#1B2140"
                BoxShadow="0 4 14 0 #55000000"
                HorizontalAlignment="Center">
            <TextBlock x:Name="Bubble" Foreground="#E8E4D4" FontSize="14"
                       TextWrapping="Wrap" MaxWidth="220" />
        </Border>
        <local:MoonView x:Name="Moon" Grid.Row="1"
                        AutomationProperties.Name="MoonBot" />
    </Grid>
</Window>
